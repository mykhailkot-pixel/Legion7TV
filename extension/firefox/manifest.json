{
  "manifest_version": 3,
  "name": "Legion7TV",
  "version": "5.9.0",
  "description": "Расширение чата Multidonate с эмоутами 7TV и настройками.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Legion7TV"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://play.multidonate.ru/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.ivr.fi/*",
    "https://ibb.co/*",
    "https://www.ibb.co/*",
    "https://imgbb.com/*",
    "https://www.imgbb.com/*",
    "https://i.ibb.co/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://play.multidonate.ru/*"],
      "css": ["styles.css"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://play.multidonate.ru/*"],
      "js": ["site-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "legion7tv@mykhailkot-pixel.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
