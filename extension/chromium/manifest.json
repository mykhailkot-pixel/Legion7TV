{
  "manifest_version": 3,
  "name": "Legion7TV",
  "version": "5.4.2",
  "description": "Расширение чата Multidonate с эмоутами 7TV и настройками.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Legion7TV"
  },
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://play.multidonate.ru/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.ivr.fi/*",
    "https://ibb.co/*",
    "https://www.ibb.co/*",
    "https://imgbb.com/*",
    "https://www.imgbb.com/*",
    "https://i.ibb.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.multidonate.ru/*"],
      "css": ["styles.css"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://play.multidonate.ru/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
